# Copy this file to .env and fill in the values before running docker compose.
#
#   cp .env.example .env

# ── GitHub OAuth (Device Flow) ───────────────────────────────────────────────
# Register at: https://github.com/settings/developers → OAuth Apps
# Enable Device Flow (no redirect URI needed).
GITHUB_CLIENT_ID=your_github_client_id_here

# ── Ollama ────────────────────────────────────────────────────────────────────
# Which model to use. Pull it first:
#   docker compose exec ollama ollama pull codellama
OLLAMA_MODEL=codellama
