# ── GitHub OAuth (Device Flow) ──────────────────────────────────────────────
# Register at: https://github.com/settings/developers -> OAuth Apps
# Set "Application type" to use Device Flow (no redirect URI needed)
GITHUB_CLIENT_ID=your_github_client_id_here

# ── Ollama ───────────────────────────────────────────────────────────────────
# Run Ollama locally: https://ollama.com
# Pull a model: ollama pull codellama
# Start server:  ollama serve
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=codellama

# ── Database ─────────────────────────────────────────────────────────────────
# Default: SQLite (dev only, no setup needed)
# Production: switch to PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/codereview
